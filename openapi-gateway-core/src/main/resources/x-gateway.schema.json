{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johnowl/oas-spring-boot-gateway/x-gateway.schema.json",
  "title": "x-gateway",
  "description": "Root-level x-gateway object of an OAS file. See specs/006-x-gateway-extension.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upstream"
  ],
  "properties": {
    "upstream": {
      "description": "Backend address: scheme://host[:port], without a path.",
      "type": "string",
      "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
    },
    "prefix": {
      "description": "Public path prefix. The gateway removes it before it calls the backend.",
      "type": "string",
      "pattern": "^(/[a-z0-9-]+)+$"
    },
    "upstream-base-path": {
      "description": "Base path on the backend. The gateway adds it before the OAS path.",
      "type": "string",
      "pattern": "^(/[A-Za-z0-9._-]+)+$"
    },
    "audience": {
      "description": "Client id (GUID, lowercase) of the backend Microsoft Entra ID app registration.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "$defs": {
    "authorization": {
      "description": "Operation-level x-gateway-authorization object. See specs/018-authorization-extension.md.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all-of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "any-of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "authenticated-only": {
          "const": true
        }
      },
      "if": {
        "type": "object"
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "authenticated-only",
                "all-of"
              ]
            },
            {
              "required": [
                "authenticated-only",
                "any-of"
              ]
            }
          ]
        }
      }
    }
  }
}
