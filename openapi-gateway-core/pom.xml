<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.johnowl.gateway</groupId>
        <artifactId>oas-spring-boot-gateway-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>openapi-gateway-core</artifactId>
    <name>openapi-gateway-core</name>
    <description>OAS parsing, validation rules, route model and access rules. No Spring Cloud Gateway or WebFlux dependency.</description>

    <properties>
        <!-- Not published. The shaded CLI jar contains core (spec 012). -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <!-- YAML events: SpecLoader rejects anchors, aliases, merge keys and tags. -->
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>no-spring-in-core</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- The CLI uses core without Spring. Core must stay framework-free.
                                     Every scope on the main classpath is banned. Only tests may use
                                     spring-web, to compare PathSyntax with PathPattern. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework:*:*:*:compile</exclude>
                                        <exclude>org.springframework:*:*:*:provided</exclude>
                                        <exclude>org.springframework:*:*:*:runtime</exclude>
                                        <exclude>org.springframework:*:*:*:system</exclude>
                                        <exclude>org.springframework.*:*:*:*:compile</exclude>
                                        <exclude>org.springframework.*:*:*:*:provided</exclude>
                                        <exclude>org.springframework.*:*:*:*:runtime</exclude>
                                        <exclude>org.springframework.*:*:*:*:system</exclude>
                                        <exclude>io.projectreactor*:*:*:*:compile</exclude>
                                        <exclude>io.projectreactor*:*:*:*:provided</exclude>
                                        <exclude>io.projectreactor*:*:*:*:runtime</exclude>
                                        <exclude>io.projectreactor*:*:*:*:system</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
